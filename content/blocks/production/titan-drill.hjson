rotateSpeed: 4.5
drawMineItem: true
hasPower: true
hasLiquids: true
consumes: {
  power: 2.2
  liquid: {
    liquid: chilled-water
    amount: 0.1
    optional: true
    booster: true
  }
}
requirements: [
  glacite/130
  cryo-shale/90
  polar-quartz/60
  subzero-silicon/40
]
category: production
research: cryo-drill
